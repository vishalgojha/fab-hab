{
  "name": "UserAchievement",
  "type": "object",
  "properties": {
    "badge_id": {
      "type": "string"
    },
    "unlocked_at": {
      "type": "string",
      "format": "date-time"
    },
    "shared": {
      "type": "boolean",
      "default": false
    },
    "is_new": {
      "type": "boolean",
      "default": true,
      "description": "Whether the user has seen this achievement"
    }
  },
  "required": [
    "badge_id"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}