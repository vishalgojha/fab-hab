{
  "name": "ChallengeParticipant",
  "type": "object",
  "properties": {
    "challenge_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the participant"
    },
    "user_name": {
      "type": "string",
      "description": "Display name of the participant"
    },
    "team_name": {
      "type": "string",
      "description": "Team name for team-based challenges"
    },
    "current_progress": {
      "type": "number",
      "default": 0,
      "description": "Current progress value"
    },
    "rank": {
      "type": "number",
      "description": "Current rank in the challenge"
    },
    "joined_date": {
      "type": "string",
      "format": "date-time"
    },
    "completed": {
      "type": "boolean",
      "default": false
    },
    "completed_date": {
      "type": "string",
      "format": "date-time"
    },
    "last_activity": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "challenge_id",
    "user_email"
  ],
  "rls": {
    "create": {
      "user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}